# CloudTorrent Environment Configuration

# Application
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=dev-super-secret-key-change-this-in-production-min-32-chars
APP_PORT=8000
FRONTEND_PORT=3000

# Database (PostgreSQL)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=cloudtorrent_db
POSTGRES_USER=cloudtorrent
POSTGRES_PASSWORD=cloudtorrent_secret
# Async connection URL
DATABASE_URL=postgresql+asyncpg://cloudtorrent:cloudtorrent_secret@127.0.0.1:5432/cloudtorrent_db

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://127.0.0.1:6379/0

# Storage Directories
STORAGE_INCOMPLETE_PATH=./volumes/data/incomplete
STORAGE_COMPLETED_PATH=./volumes/data/completed
STORAGE_RESUME_PATH=./volumes/data/resume_data

# Quotas and Limits
DEFAULT_STORAGE_QUOTA_BYTES=53687091200  # 50 GB
DEFAULT_MAX_ACTIVE_JOBS=3
GLOBAL_MAX_CONCURRENT_DOWNLOADS=10
DEFAULT_LINK_EXPIRATION_HOURS=24
