# ===========================================================================
# CloudTorrent Production Environment Configuration
# ===========================================================================
# Copy this file to .env before running: docker compose up -d

# ---------------------------------------------------------------------------
# Application Security & Environment
# ---------------------------------------------------------------------------
APP_ENV=production
APP_DEBUG=false

# Generate a cryptographically secure 64-character secret key:
# Run: openssl rand -hex 32
APP_SECRET_KEY=replace-with-a-cryptographically-secure-random-32-byte-secret-hex

# External HTTP exposed port on host (e.g., 80 or 8080 behind cloud load balancer)
PORT=80

# ---------------------------------------------------------------------------
# Database Configuration (PostgreSQL 16)
# ---------------------------------------------------------------------------
POSTGRES_DB=cloudtorrent_db
POSTGRES_USER=cloudtorrent
# Set a strong, unique database password:
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password

# ---------------------------------------------------------------------------
# Redis Cache & Message Broker
# ---------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Storage Mounts & Directory Paths (Inside Container)
# ---------------------------------------------------------------------------
STORAGE_INCOMPLETE_PATH=/data/incomplete
STORAGE_COMPLETED_PATH=/data/completed
STORAGE_RESUME_PATH=/data/resume_data

# ---------------------------------------------------------------------------
# Default Resource Quotas & Bandwidth Governance
# ---------------------------------------------------------------------------
# Default per-user storage allocation in bytes (50 GB default)
DEFAULT_STORAGE_QUOTA_BYTES=53687091200

# Default per-user maximum concurrent active download jobs
DEFAULT_MAX_ACTIVE_JOBS=3

# Global cluster-wide simultaneous active downloads
GLOBAL_MAX_CONCURRENT_DOWNLOADS=10

# Global download rate limit in KB/s (0 = unthrottled gigabit)
DEFAULT_DOWNLOAD_RATE_LIMIT_KBPS=0

# Global upload / seeding rate limit in KB/s (0 = unthrottled)
DEFAULT_UPLOAD_RATE_LIMIT_KBPS=0

# Default direct HTTPS download link expiration in hours
DEFAULT_LINK_EXPIRATION_HOURS=24

# ---------------------------------------------------------------------------
# Initial Superuser Bootstrapping
# ---------------------------------------------------------------------------
DEFAULT_ADMIN_EMAIL=admin@cloudtorrent.io
DEFAULT_ADMIN_PASSWORD=replace-with-secure-admin-password
DEFAULT_ADMIN_NAME="System Administrator"
